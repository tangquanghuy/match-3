        document.body.style.setProperty('--reading-font-user', family);
      } else {
        document.body.style.removeProperty('--font-main');
        document.body.style.removeProperty('--serif');
        document.body.style.removeProperty('--kai');
        document.body.style.removeProperty('--reading-font-user');
      }
    }

    function ensureGoogleReadingFonts() {
      if (document.getElementById('readingFontStylesheet')) return;
      const link = document.createElement('link');
      link.id = 'readingFontStylesheet';
      link.rel = 'stylesheet';
      link.href = GOOGLE_READING_FONT_HREF;
      document.head.appendChild(link);
    }

    function isReadingFontCached(fontKey) {
      const mainFamily = REMOTE_READING_FONT_FAMILIES[fontKey];
      if (!mainFamily || !document.fonts || typeof document.fonts.check !== 'function') return false;
      try {
        return document.fonts.check(`400 18px ${mainFamily}`, '正文阅读对白');
      } catch (e) {
        return false;
      }
    }

    async function waitForReadingFontReady(fontKey, timeoutMs = 240) {
      const mainFamily = REMOTE_READING_FONT_FAMILIES[fontKey];
      if (!mainFamily || !document.fonts || typeof document.fonts.load !== 'function') return true;
      if (isReadingFontCached(fontKey)) return true;

      if (fontKey === 'noto-serif') ensureGoogleReadingFonts();

      const remoteStylesheet = fontKey === 'noto-serif'
        ? document.getElementById('readingFontStylesheet')
        : fontKey === 'zhenkai'
          ? document.getElementById('zhenKaiFontStylesheet')
          : null;
      const stylesheetReady = !remoteStylesheet || remoteStylesheet.rel === 'stylesheet'
        ? Promise.resolve()
        : new Promise(resolve => {
          remoteStylesheet.addEventListener('load', resolve, { once: true });
          remoteStylesheet.addEventListener('error', resolve, { once: true });
        });

      const fontsReady = stylesheetReady
        .then(() => document.fonts.load(`400 18px ${mainFamily}`, '正文阅读对白'))
        .then(() => true)
        .catch(() => false);
      return Promise.race([
        fontsReady,
        new Promise(resolve => setTimeout(() => resolve(false), timeoutMs))
      ]);
    }

    function applyReadingFont(fontKey, options = {}) {
      const normalizedKey = Object.prototype.hasOwnProperty.call(READING_FONT_PRESETS, fontKey)
        ? fontKey
        : 'theme-default';
      const preset = READING_FONT_PRESETS[normalizedKey];
      const readingFontSelect = document.getElementById('readingFontSelect');

      if (normalizedKey === 'noto-serif') ensureGoogleReadingFonts();
      applyReadingFontStack(preset.family);

      if (readingFontSelect && readingFontSelect.value !== normalizedKey) {
        readingFontSelect.value = normalizedKey;
