          button?.classList.toggle('expanded', isActive);
          if (textSpan) {
            textSpan.textContent = isActive ? '收起插画' : '查看插画';
          }
        });
        showSettingsMessage(isActive ? '已开启默认展开插画' : '已关闭默认展开插画');
      });

      dialogueFontToggle.addEventListener('click', function () {
        this.classList.toggle('active');
        const isActive = this.classList.contains('active');
        localStorage.setItem('unified-dialogue-font', isActive);
        document.body.classList.toggle('unified-dialogue-font', isActive);
        showSettingsMessage(isActive ? '已统一对白与正文字体大小' : '已恢复对白独立字体大小');
      });

      if (innerVoiceToggle) {
        innerVoiceToggle.addEventListener('click', function () {
          this.classList.toggle('active');
          const isActive = this.classList.contains('active');
          window.__namedInnerVoiceDefaultExpand = isActive;
          localStorage.setItem('inner-voice-auto-expand', isActive);
          document.querySelectorAll('.named-inner-voice').forEach(panel => setNamedInnerVoiceOpen(panel, isActive));
          showSettingsMessage(isActive ? '已开启默认展开心声' : '已关闭默认展开心声');
        });
      }

      if (readingFontSelect) {
        readingFontSelect.addEventListener('change', function () {
          const fontKey = applyReadingFont(this.value);
          showSettingsMessage(`已切换为${READING_FONT_PRESETS[fontKey].label}`);
        });
      }

      document.addEventListener('click', function (e) {
        if (!settingsPanel.contains(e.target) && !settingsBtn.contains(e.target)) settingsPanel.classList.remove('active');
      });
    }

    function showSettingsMessage(message) {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'toast-message';
      messageDiv.textContent = message;
      document.body.appendChild(messageDiv);
      setTimeout(() => messageDiv.remove(), 2000);
    }

    // Theme setter helper
    const VALID_THEMES = new Set(['warm-white', 'paper-white', 'dark', 'green']);

    const updateThemeButtons = (theme) => {
      localStorage.setItem('kivotos-theme', theme);
      localStorage.setItem('theme', theme); // compatible backup
      document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
      document.querySelectorAll('.control-btn[data-theme-key]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.themeKey === theme);
      });
      syncThemeMenuLabel(theme);
    };

    const notifyEmbeddedThemeChange = (theme) => {
      document.querySelectorAll('iframe').forEach((frame) => {
        try {
          frame.contentWindow?.postMessage({ type: 'kivotos-theme-change', theme }, '*');
        } catch (err) { }
      });
    };

    const commitTheme = (theme) => {
      document.body.setAttribute('data-theme', theme);
      updateThemeButtons(theme);
      notifyEmbeddedThemeChange(theme);
    };

    const applyTheme = (theme, skipAnimation = false) => {
      const normalizedTheme = VALID_THEMES.has(theme) ? theme : 'warm-white';

      if (!skipAnimation && document.startViewTransition) {
        document.startViewTransition(() => commitTheme(normalizedTheme));
        return;
      }

      commitTheme(normalizedTheme);
    };

    // Expose for HTML onclick
    window.setTheme = applyTheme;

    function initThemeSwitcher(skipAnimation = false) {
      const savedTheme = window.__initialTheme || localStorage.getItem('kivotos-theme') || localStorage.getItem('theme') || 'warm-white';
      applyTheme(savedTheme, skipAnimation);
    }

    // 移动端主题切换收起：只显示当前主题，点击展开全部，选完自动收回。
    // 注意：#inlineControls 在正文渲染时会随 #readingContent 一起被重建，
    // 所以状态每次现查节点、事件走 document 委托，不能把监听绑在某个具体节点上。
    const THEME_COLLAPSE_QUERY = '(max-width: 720px)';

    function syncThemeCollapseMode() {
      const box = document.getElementById('inlineControls');
      if (!box) return null;
      const collapse = window.matchMedia(THEME_COLLAPSE_QUERY).matches;
      box.classList.toggle('is-theme-collapsed', collapse);
      if (!collapse) box.classList.remove('is-theme-open');
      // 正文重渲染后触发按钮是新节点，这里补一次当前主题文字
      syncThemeMenuLabel(document.body.dataset.theme || 'warm-white');
      return box;
    }

    function initThemeCollapse() {
      syncThemeCollapseMode();
      if (window.__themeCollapseBound) return;
      window.__themeCollapseBound = true;

      const mq = window.matchMedia(THEME_COLLAPSE_QUERY);
      if (typeof mq.addEventListener === 'function') mq.addEventListener('change', syncThemeCollapseMode);
      else if (typeof mq.addListener === 'function') mq.addListener(syncThemeCollapseMode);

      document.addEventListener('click', (event) => {
        const box = syncThemeCollapseMode();
        if (!box) return;
        // 点面板外收起
        if (!box.contains(event.target)) {
          setThemeMenuOpen(box, false);
          return;
        }
        if (!box.classList.contains('is-theme-collapsed')) return;
        // 点「当前主题 ▾」开合下拉
        if (event.target.closest?.('.theme-switch__trigger')) {
          setThemeMenuOpen(box, !box.classList.contains('is-theme-open'));
          return;
        }
        // 在下拉里选了某个主题：切换由按钮自身的 onclick 完成，这里只负责收起
        if (event.target.closest?.('.theme-switch__menu .control-btn')) {
          setThemeMenuOpen(box, false);
        }
      });
    }

    function setThemeMenuOpen(box, open) {
      box.classList.toggle('is-theme-open', open);
      const trigger = box.querySelector('.theme-switch__trigger');
      if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // 触发按钮上的文字始终显示当前主题
    function syncThemeMenuLabel(theme) {
      const label = document.getElementById('themeMenuLabel');
      const trigger = document.getElementById('themeMenuTrigger');
      const active = document.querySelector('.theme-switch__menu .control-btn[data-theme-key="' + theme + '"]');
      if (label && active) label.textContent = active.textContent.trim();
      if (trigger && active) trigger.title = active.title || '切换主题';
    }

    function updateReadingWidthControls() {
      const level = READING_WIDTH_LEVELS[readingWidthLevel];
      const value = document.getElementById('readingWidthValue');
      const decrease = document.getElementById('readingWidthDecrease');
      const increase = document.getElementById('readingWidthIncrease');

      if (value) value.textContent = level.label;
      if (decrease) decrease.disabled = readingWidthLevel <= 0;
      if (increase) increase.disabled = readingWidthLevel >= READING_WIDTH_LEVELS.length - 1;
    }

    function syncHostLayout() {
      let hostViewportWidth = window.innerWidth;
      try {
        hostViewportWidth = Number(window.parent?.innerWidth) || window.innerWidth;
      } catch (e) { }
      const nextLayout = hostViewportWidth > 768 ? 'desktop' : 'mobile';
      document.body?.setAttribute('data-host-layout', nextLayout);
      return nextLayout;
    }

    let hostLayoutResizeRaf = 0;
    function queueHostLayoutSync() {
      if (hostLayoutResizeRaf) return;
      hostLayoutResizeRaf = requestAnimationFrame(() => {
        hostLayoutResizeRaf = 0;
        syncHostLayout();
      });
    }
    window.addEventListener('resize', queueHostLayoutSync, { passive: true });
    window.addEventListener('orientationchange', queueHostLayoutSync, { passive: true });
    try {
      if (window.parent && window.parent !== window) {
        window.parent.addEventListener('resize', queueHostLayoutSync, { passive: true });
      }
    } catch (e) { }

    function applyReadingWidth(options = {}) {
      readingWidthLevel = Math.max(0, Math.min(READING_WIDTH_LEVELS.length - 1, readingWidthLevel));
      const level = READING_WIDTH_LEVELS[readingWidthLevel];
      const parentWindow = window.parent;
      let parentDocument = null;
      try {
        parentDocument = parentWindow?.document || null;
      } catch (e) {
        parentDocument = null;
      }

      document.body?.setAttribute('data-reading-width-level', String(readingWidthLevel));
      syncHostLayout();
      updateReadingWidthControls();
      if (!parentDocument) return;

      // SillyTavern uses --sheldWidth for #sheld, #top-bar and #send_form.
      parentDocument.documentElement.style.setProperty('--sheldWidth', `${level.chatWidth}vw`);

      const slider = parentDocument.getElementById('chat_width_slider');
      const counter = parentDocument.getElementById('chat_width_slider_counter');
      if (slider) slider.value = String(level.chatWidth);
      if (counter) counter.value = String(level.chatWidth);

      const context = window.SillyTavern?.getContext?.() || window.SillyTavern;
      if (context?.powerUserSettings) {
        context.powerUserSettings.chat_width = level.chatWidth;
      }

      if (!options.skipPersist) {
        localStorage.setItem(READING_WIDTH_STORAGE_KEY, String(readingWidthLevel));

        // Trigger SillyTavern's own handler so the setting is saved exactly like its Chat Width slider.
        if (slider && typeof parentWindow.$ === 'function') {
          parentWindow.$(slider).val(level.chatWidth).trigger('input', { forced: true });
        } else {
          context?.saveSettingsDebounced?.();
        }
      }
    }

    function getHostReadingWidth() {
      const parentWindow = window.parent;
      let parentDocument = null;
      try {
        parentDocument = parentWindow?.document || null;
      } catch (e) {
        parentDocument = null;
      }

      const sliderValue = Number.parseFloat(parentDocument?.getElementById('chat_width_slider')?.value);
      if (Number.isFinite(sliderValue)) return sliderValue;

      let context = null;
      try {
        context = window.SillyTavern?.getContext?.()
          || window.SillyTavern
          || parentWindow?.SillyTavern?.getContext?.()
          || parentWindow?.SillyTavern;
      } catch (e) { }
      const settingValue = Number.parseFloat(context?.powerUserSettings?.chat_width);
      if (Number.isFinite(settingValue)) return settingValue;

      try {
        const rootStyle = parentDocument?.documentElement;
        const inlineWidth = Number.parseFloat(rootStyle?.style?.getPropertyValue('--sheldWidth'));
        if (Number.isFinite(inlineWidth)) return inlineWidth;
        const computedWidth = Number.parseFloat(parentDocument?.defaultView?.getComputedStyle(rootStyle)?.getPropertyValue('--sheldWidth'));
        if (Number.isFinite(computedWidth)) return computedWidth;
      } catch (e) { }

      return null;
    }

    function getClosestReadingWidthLevel(chatWidth) {
      if (!Number.isFinite(chatWidth)) return 0;
      return READING_WIDTH_LEVELS.reduce((closestIndex, level, index, levels) => {
        const closestDistance = Math.abs(level.chatWidth - chatWidth);
        const currentDistance = Math.abs(levels[closestIndex].chatWidth - chatWidth);
        return currentDistance < closestDistance ? closestIndex : index;
      }, 0);
    }

    function initReadingWidth() {
      const savedValue = localStorage.getItem(READING_WIDTH_STORAGE_KEY);
      const savedLevel = Number.parseInt(savedValue ?? '', 10);

      // Without a saved manual choice, only sync the controls to the host width.
      if (savedValue === null || Number.isNaN(savedLevel)) {
        readingWidthLevel = getClosestReadingWidthLevel(getHostReadingWidth());
        document.body?.removeAttribute('data-reading-width-level');
        syncHostLayout();
        updateReadingWidthControls();
        return;
      }

      // Restore only a value explicitly saved by clicking this page.
      readingWidthLevel = Math.max(0, Math.min(READING_WIDTH_LEVELS.length - 1, savedLevel));
      applyReadingWidth({ skipPersist: true });
    }

    function adjustReadingWidth(delta) {
      const nextLevel = Math.max(0, Math.min(READING_WIDTH_LEVELS.length - 1, readingWidthLevel + delta));
      if (nextLevel === readingWidthLevel) {
        updateReadingWidthControls();
        return;
      }

      readingWidthLevel = nextLevel;
      applyReadingWidth();
      showSettingsMessage(`阅读宽度：${READING_WIDTH_LEVELS[readingWidthLevel].label}`);
    }

    window.adjustReadingWidth = adjustReadingWidth;

    function adjustReadingFontSize(delta) {
      readingFontSize = Math.max(12, Math.min(28, readingFontSize + delta));
      const readingContent = document.querySelector('.reading-content');
      if (readingContent) readingContent.style.fontSize = readingFontSize + 'px';
      localStorage.setItem('readingFontSize', readingFontSize);
    }

    function adjustImageSize(delta) {
      imageSize = Math.max(30, Math.min(200, imageSize + delta));
      applyImageSize();
      localStorage.setItem('imageSize', imageSize);
      showSettingsMessage(`插画大小: ${imageSize}%`);
    }

    function applyImageSize() {
      document.querySelectorAll('.image-content img').forEach(img => {
        img.style.width = imageSize + '%';
        img.style.maxWidth = imageSize + '%';
        img.style.height = 'auto';
      });
    }

    // --- Animation Observer: pause infinite animations when off-screen ---
    function initAnimationObserver() {
      if (window.__animationObserverBound) return;
      window.__animationObserverBound = true;
      const animSelectors = '.shimmer-text, .action-shimmer, .skill-name-wave, .enemy-hp-fill, .summon-hp-fill, .dice-roll-tag.crit, .badge-glow-success, .badge-glow-danger, .item-shimmer-artifact, .item-shimmer-legendary, .item-shimmer-epic, .item-shimmer-mythic, .sparkle, .name-initial-\u7279\u56FE';
      if (!document.getElementById('animationPauseStyle')) {
        const style = document.createElement('style');
        style.id = 'animationPauseStyle';
        style.textContent = '.anim-paused { animation-play-state: paused !important; }';
        document.head.appendChild(style);
      }
      if (!('IntersectionObserver' in window)) return;
      const root = document.getElementById('readingContent') || document.body;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => entry.target.classList.toggle('anim-paused', !entry.isIntersecting));
      }, { rootMargin: '200px 0px' });
      const observeElement = (el) => {
        if (!(el instanceof Element)) return;
        if (el.matches(animSelectors) && !el.dataset.animObserved) {
          el.dataset.animObserved = '1';
          observer.observe(el);
        }
        if (!el.firstElementChild) return;
        el.querySelectorAll(animSelectors).forEach(child => {
          if (!child.dataset.animObserved) {
            child.dataset.animObserved = '1';
            observer.observe(child);
          }
        });
      };
      observeElement(root);
      const pendingAnimationNodes = new Set();
      let animationObserveRaf = 0;
      const flushAnimationNodes = () => {
        animationObserveRaf = 0;
        pendingAnimationNodes.forEach(observeElement);
        pendingAnimationNodes.clear();
      };
      const mo = new MutationObserver(records => {
        records.forEach(record => record.addedNodes.forEach(node => {
          if (node.nodeType === 1) pendingAnimationNodes.add(node);
        }));
        if (pendingAnimationNodes.size && !animationObserveRaf) {
          animationObserveRaf = requestAnimationFrame(flushAnimationNodes);
        }
      });
      mo.observe(root, { childList: true, subtree: true });
      window.__animationObserver = observer;
      window.__animationMutationObserver = mo;
    }
  </script>
