            requestAnimationFrame(revealReading);
          } else {
            revealReading();
            step('waitForReadingFontReady', () => waitForReadingFontReady(fontKey));
          }
        } catch (err) {
          console.error('[正文美化] 初始化异常，正文按原样显示', err);
          revealReading();
        }
      });
    });

