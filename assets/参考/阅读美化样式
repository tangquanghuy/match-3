          step('initImageGenResponseListener', initImageGenResponseListener);
          step('initSettings', initSettings);
          step('initReadingWidth', initReadingWidth);
          step('initAvatarUpload', initAvatarUpload);
          step('renderCustomCharList', renderCustomCharList);
          step('正文字号', () => {
