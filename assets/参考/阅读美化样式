  <script>
    // 角色表由浏览器缓存中的自定义角色动态填充。
    const CHARACTER_CONFIG = {};
    const BUILTIN_CHAR_NAMES = [];


    const AVATAR_CACHE_PREFIX = 'custom_char_avatar_';
    const CHAR_CACHE_KEY = 'custom_char_cache';

    function getAllCachedChars() {
      try {
        const raw = localStorage.getItem(CHAR_CACHE_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch (e) { return {}; }
    }

    function saveCachedChars(chars) {
      try {
        localStorage.setItem(CHAR_CACHE_KEY, JSON.stringify(chars));
        return true;
      } catch (e) {
        console.warn('Custom character cache write failed:', e);
        return false;
      }
    }

    function normalizeAvatarNetworkUrl(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      try {
        const url = new URL(raw, window.location.href);
        return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : '';
      } catch (e) { return ''; }
    }

    function isLocalAvatarData(value) {
      return /^data:image\//i.test(String(value || ''));
    }

    function estimateAvatarStorageBytes(value) {
      return String(value || '').length * 2;
    }

    function getLocalAvatarCacheUsageBytes(excludeName = '') {
      let total = 0;
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i) || '';
          if (!key.startsWith(AVATAR_CACHE_PREFIX)) continue;
          const name = key.slice(AVATAR_CACHE_PREFIX.length);
          if (excludeName && name === excludeName) continue;
          const value = localStorage.getItem(key) || '';
          if (isLocalAvatarData(value)) total += estimateAvatarStorageBytes(value);
        }
      } catch (e) { }
      return total;
    }

    function formatAvatarBytes(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    function updateAvatarStorageHint() {
      const hint = document.getElementById('customCharStorageHint');
      if (!hint || typeof AVATAR_CACHE_TOTAL_MAX_BYTES === 'undefined') return;
      const used = getLocalAvatarCacheUsageBytes();
      hint.textContent = '\u672c\u5730\u5934\u50cf\u7f13\u5b58\uff1a' + formatAvatarBytes(used) + ' / ' + formatAvatarBytes(AVATAR_CACHE_TOTAL_MAX_BYTES) + '\uff1b\u7f51\u7edc\u94fe\u63a5\u4e0d\u8ba1\u5165\u4e0a\u9650';
    }

    function saveAvatarToCache(charName, avatarValue) {
      const value = String(avatarValue || '');
      if (isLocalAvatarData(value)) {
        const projected = getLocalAvatarCacheUsageBytes(charName) + estimateAvatarStorageBytes(value);
        if (projected > AVATAR_CACHE_TOTAL_MAX_BYTES) return { ok: false, reason: 'limit', projected };
      }
      try {
        localStorage.setItem(AVATAR_CACHE_PREFIX + charName, value);
        return { ok: true };
      } catch (e) {
        console.warn('Avatar cache write failed:', e);
        return { ok: false, reason: 'storage', error: e };
      }
    }

    function getAvatarFromCache(charName) {
      try { return localStorage.getItem(AVATAR_CACHE_PREFIX + charName) || ''; } catch (e) { return ''; }
    }

    function removeAvatarFromCache(charName) {
      try { localStorage.removeItem(AVATAR_CACHE_PREFIX + charName); } catch (e) { }
      updateAvatarStorageHint();
    }

    // ==================== 浏览器缓存角色 ====================
    function injectCustomCharCSS(name, color) {
      if (!color) return;
      const styleId = 'custom-char-css-' + name;
      if (document.getElementById(styleId)) document.getElementById(styleId).remove();
      const style = document.createElement('style');
      style.id = styleId;
      const darkColor = lightenColor(color, 50);
      style.textContent = `.char-${CSS.escape(name)} .character-name .name-main { color: ${color} }
.name-initial-${CSS.escape(name)} { color: ${color}; }
body[data-theme="dark"] .char-${CSS.escape(name)} .character-name .name-main { color: ${darkColor} }
body[data-theme="dark"] .name-initial-${CSS.escape(name)} { color: ${darkColor}; }`;
      document.head.appendChild(style);
    }

    function lightenColor(hex, amount) {
      const num = parseInt(hex.replace('#', ''), 16);
      let r = Math.min(255, (num >> 16) + amount);
      let g = Math.min(255, ((num >> 8) & 0xff) + amount);
      let b = Math.min(255, (num & 0xff) + amount);
      return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }

    Object.entries(CHARACTER_CONFIG).forEach(([name, cfg]) => {
      if (cfg?.color) injectCustomCharCSS(name, cfg.color);
    });

    // ==================== 加载自定义角色到 CHARACTER_CONFIG ====================
    // 从浏览器缓存读取自定义角色的头像和颜色
    function loadCustomCharsIntoConfig() {
      const cachedChars = getAllCachedChars();
      Object.keys(cachedChars).forEach(name => {
        if (BUILTIN_CHAR_NAMES.includes(name) || CHARACTER_CONFIG[name]) return;
        const cached = cachedChars[name] || {};
        const avatar = getAvatarFromCache(name);
        const color = cached.color || '';
        CHARACTER_CONFIG[name] = { avatar, aliases: [name], given_name: name, color: color || undefined, _custom: true };
        if (color) injectCustomCharCSS(name, color);
      });
    }

    function renderCacheCharList() {
      const listEl = document.getElementById('cacheCharList');
      if (!listEl) return;
      updateAvatarStorageHint();
      const cachedChars = getAllCachedChars();
      const names = Object.keys(cachedChars);
      if (names.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:var(--text-muted);font-size:12px;padding:8px;">缓存库为空，点击下方新建角色</div>';
        return;
      }
      let html = '';
      names.forEach(name => {
        const info = cachedChars[name] || {};
        const avatarSrc = getAvatarFromCache(name);
        const avatarHtml = avatarSrc
          ? `<img class="custom-char-avatar-small" src="${avatarSrc}" alt="${name}" loading="lazy" decoding="async">`
          : `<div class="custom-char-avatar-placeholder-small">🎭</div>`;
        const colorDot = info.color ? `<span class="custom-char-color-dot" style="background:${info.color}"></span>` : '';
        html += `<div class="custom-char-item">
          ${avatarHtml} ${colorDot}
          <span class="custom-char-name">${name}</span>
          <button class="custom-char-delete" onclick="deleteCacheChar('${name.replace(/'/g, "\\'")}')" title="从缓存删除">✕</button>
        </div>`;
      });
      listEl.innerHTML = html;
    }

    function renderCustomCharList() {
      renderCacheCharList();
    }

    let _pendingAvatarData = '';
    let _pendingAvatarKind = '';

    window.showAddCustomCharForm = function () {
      document.getElementById('customCharAddForm').style.display = 'block';
      document.getElementById('customCharAddBtn').style.display = 'none';
      document.getElementById('customCharNameInput').value = '';
      document.getElementById('customCharColorInput').value = '#a06050';
      const preview = document.getElementById('customCharAvatarPreview');
      preview.style.display = 'none';
      preview.removeAttribute('src');
      const urlInput = document.getElementById('customCharAvatarUrlInput');
      if (urlInput) urlInput.value = '';
      const fileInput = document.getElementById('customCharFileInput');
      if (fileInput) fileInput.value = '';
      const uploadBtn = document.getElementById('customCharUploadBtn');
      if (uploadBtn) uploadBtn.textContent = '📷 上传本地头像';
      _pendingAvatarData = '';
      _pendingAvatarKind = '';
      updateAvatarStorageHint();
    };

    window.cancelAddCustomChar = function () {
      document.getElementById('customCharAddForm').style.display = 'none';
      document.getElementById('customCharAddBtn').style.display = 'block';
      const preview = document.getElementById('customCharAvatarPreview');
      preview.removeAttribute('src');
      preview.style.display = 'none';
      _pendingAvatarData = '';
      _pendingAvatarKind = '';
    };

    window.confirmAddCustomChar = function () {
      const name = document.getElementById('customCharNameInput').value.trim();
      if (!name) { showSettingsMessage('请输入角色名称'); return; }
      if (BUILTIN_CHAR_NAMES.includes(name)) { showSettingsMessage('不能与内置角色同名'); return; }
      const cachedChars = getAllCachedChars();
      if (cachedChars[name]) { showSettingsMessage('缓存中已存在该角色'); return; }
      const urlInput = document.getElementById('customCharAvatarUrlInput');
      const rawUrl = urlInput ? urlInput.value.trim() : '';
      const networkUrl = rawUrl ? normalizeAvatarNetworkUrl(rawUrl) : '';
      if (rawUrl && !networkUrl) { showSettingsMessage('请输入有效的 http/https 头像链接'); return; }
      const avatarValue = networkUrl || _pendingAvatarData;
      const avatarKind = networkUrl ? 'url' : _pendingAvatarKind;
      if (!avatarValue) { showSettingsMessage('请上传头像或输入头像网络链接'); return; }
      const color = document.getElementById('customCharColorInput').value || '';
      const avatarSave = saveAvatarToCache(name, avatarValue);
      if (!avatarSave.ok) {
        showSettingsMessage(avatarSave.reason === 'limit'
          ? '本地头像缓存已达 ' + formatAvatarBytes(AVATAR_CACHE_TOTAL_MAX_BYTES) + ' 上限，请删除旧头像或改用网络链接'
          : '头像缓存写入失败，请清理浏览器存储');
        updateAvatarStorageHint();
        return;
      }
      cachedChars[name] = { color: color, avatarType: avatarKind || (isLocalAvatarData(avatarValue) ? 'local' : 'url') };
      CHARACTER_CONFIG[name] = { avatar: avatarValue, aliases: [name], given_name: name, color: color || undefined, _custom: true };
      if (color) injectCustomCharCSS(name, color);
      if (!saveCachedChars(cachedChars)) {
        removeAvatarFromCache(name);
        delete CHARACTER_CONFIG[name];
        const failedStyle = document.getElementById('custom-char-css-' + name);
        if (failedStyle) failedStyle.remove();
        showSettingsMessage('角色缓存写入失败');
        return;
      }
      renderCacheCharList();
      cancelAddCustomChar();
      updateAvatarStorageHint();
      showSettingsMessage('已保存「' + name + '」到缓存库');
    };

    window.deleteCacheChar = function (name) {
      if (BUILTIN_CHAR_NAMES.includes(name)) return;
      const cachedChars = getAllCachedChars();
      delete cachedChars[name];
      saveCachedChars(cachedChars);
      removeAvatarFromCache(name);
      delete CHARACTER_CONFIG[name];
      const styleEl = document.getElementById('custom-char-css-' + name);
      if (styleEl) styleEl.remove();
      renderCacheCharList();
      showSettingsMessage(`已从缓存删除「${name}」`);
    };

    const AVATAR_UPLOAD_MAX_BYTES = 5 * 1024 * 1024; // 上传文件上限 5MB
    const AVATAR_STORAGE_TARGET_BYTES = 480 * 1024; // 单头像建议占用，避免撑爆 localStorage
    const AVATAR_CACHE_TOTAL_MAX_BYTES = 4 * 1024 * 1024;
    const AVATAR_MAX_DIMENSION = 1024; // 超过该边长才缩放
    const AVATAR_MIN_DIMENSION = 256; // 压缩兜底最小边长

    function estimateDataUrlBytes(dataUrl) {
      const commaIndex = dataUrl.indexOf(',');
      if (commaIndex < 0) return 0;
      const base64 = dataUrl.slice(commaIndex + 1);
      const padding = (base64.match(/=+$/) || [''])[0].length;
      return Math.floor(base64.length * 3 / 4) - padding;
    }

    function encodeAvatarDataUrl(img) {
      const srcMaxSide = Math.max(img.width, img.height);
      let scale = srcMaxSide > AVATAR_MAX_DIMENSION ? AVATAR_MAX_DIMENSION / srcMaxSide : 1;
      let fallbackDataUrl = '';

      while (scale > 0) {
        const w = Math.max(1, Math.round(img.width * scale));
        const h = Math.max(1, Math.round(img.height * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (!ctx) break;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(img, 0, 0, w, h);

        const qualitySteps = [0.98, 0.95, 0.92, 0.88, 0.84, 0.8];
        let bestAtThisScale = '';
        for (const q of qualitySteps) {
          const candidate = canvas.toDataURL('image/webp', q);
          bestAtThisScale = candidate;
          if (estimateDataUrlBytes(candidate) <= AVATAR_STORAGE_TARGET_BYTES) {
            return candidate;
          }
        }
        fallbackDataUrl = bestAtThisScale;

        if (Math.max(w, h) <= AVATAR_MIN_DIMENSION) break;
        scale *= 0.85;
      }
      return fallbackDataUrl;
    }

    // 头像上传处理
    function initAvatarUpload() {
      const uploadBtn = document.getElementById('customCharUploadBtn');
      const fileInput = document.getElementById('customCharFileInput');
      const urlInput = document.getElementById('customCharAvatarUrlInput');
      const preview = document.getElementById('customCharAvatarPreview');
      if (!uploadBtn || !fileInput || !preview) return;
      uploadBtn.addEventListener('click', () => fileInput.click());

      if (urlInput) urlInput.addEventListener('change', function () {
        const normalized = normalizeAvatarNetworkUrl(this.value);
        if (!this.value.trim()) {
          if (_pendingAvatarKind === 'url') {
            _pendingAvatarData = ''; _pendingAvatarKind = '';
            preview.removeAttribute('src'); preview.style.display = 'none';
          }
          return;
        }
