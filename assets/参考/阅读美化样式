        ? savedFontKey
        : 'theme-default';
      const initialFamily = initialFontFamilies[initialFontKey];
      if (initialFamily) {
        document.body.style.setProperty('--font-main', initialFamily);
        document.body.style.setProperty('--serif', initialFamily);
        document.body.style.setProperty('--kai', initialFamily);
      }
      window.__initialReadingFontKey = initialFontKey;
    })();
