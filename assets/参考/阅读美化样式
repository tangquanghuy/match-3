    document.addEventListener('DOMContentLoaded', () => {
      initThemeSwitcher(true);
      initThemeCollapse();
      requestAnimationFrame(async () => {
        /* 每一步各自兜住异常。正文渲染（processTextContent）以前是裸调的，
           它一抛（比如某张卡片的渲染函数引用了不存在的变量），后面的 revealReading
           就永远不会执行，body 卡在 render-pending 上——表现就是整页全白。
           现在任何一步失败都只打日志，reveal 一定会跑到。 */
        const step = (label, fn) => {
          try { return fn(); }
          catch (err) { console.error('[正文美化] 初始化步骤失败：' + label, err); }
        };
        const revealReading = () => {
          document.body.classList.remove('render-pending', 'theme-preload');
          document.body.classList.add('render-ready');
        };
        try {
          // 初始化自定义角色：从MVU和缓存加载到CHARACTER_CONFIG
