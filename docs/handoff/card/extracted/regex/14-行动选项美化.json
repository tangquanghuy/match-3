  "replaceString": "```html\n<head>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:Georgia,'Noto Serif SC',serif;padding:16px;background:transparent}\n#action-raw{display:none}\n\n.realm{\n  max-width:640px;margin:0 auto;position:relative;\n  background:radial-gradient(ellipse at 30% 10%,#1e1b3a,#0e0b1f 50%,#080614);\n  border-radius:18px;overflow:hidden;\n  box-shadow:0 0 80px rgba(60,40,140,0.2),inset 0 0 80px rgba(20,10,60,0.5);\n  border:1px solid rgba(120,100,200,0.1);\n}\n.realm::before{\n  content:'';position:absolute;inset:0;pointer-events:none;\n  background:\n    radial-gradient(1.5px 1.5px at 8% 15%,#fff,transparent),\n    radial-gradient(1px 1px at 15% 70%,rgba(200,180,255,0.8),transparent),\n    radial-gradient(2px 2px at 25% 8%,rgba(255,200,100,0.9),transparent),\n    radial-gradient(1px 1px at 35% 55%,rgba(180,220,255,0.7),transparent),\n    radial-gradient(1.5px 1.5px at 50% 25%,#fff,transparent),\n    radial-gradient(1px 1px at 60% 80%,rgba(200,180,255,0.6),transparent),\n    radial-gradient(2px 2px at 72% 12%,rgba(100,200,255,0.8),transparent),\n    radial-gradient(1px 1px at 80% 60%,rgba(255,180,200,0.7),transparent),\n    radial-gradient(1.5px 1.5px at 90% 35%,rgba(255,255,200,0.8),transparent),\n    radial-gradient(1px 1px at 95% 85%,rgba(180,200,255,0.6),transparent);\n  animation:twinkle 4s ease-in-out infinite alternate;\n}\n@keyframes twinkle{0%{opacity:.6}100%{opacity:1}}\n.realm::after{\n  content:'';position:absolute;pointer-events:none;\n  width:300px;height:300px;top:-80px;right:-60px;\n  background:radial-gradient(circle,rgba(100,60,200,0.12),rgba(40,80,200,0.06),transparent 70%);\n  border-radius:50%;\n}\n\n.realm-header{\n  position:relative;padding:14px 18px;cursor:pointer;\n  display:flex;align-items:center;justify-content:center;\n}\n.hdr-chevron{\n  position:absolute;left:14px;top:50%;transform:translateY(-50%);\n  font-size:14px;color:rgba(200,190,240,0.5);\n  transition:transform .3s,color .2s;\n  font-family:-apple-system,sans-serif;\n}\n.hdr-chevron.open{transform:translateY(-50%) rotate(90deg)}\n.realm-header:hover .hdr-chevron{color:rgba(200,190,240,0.8)}\n\n.realm-title{\n  font-size:15px;letter-spacing:4px;\n  background:linear-gradient(135deg,#c8b8ff,#ffd6a8,#c8b8ff);\n  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\n}\n\n.pin-star{\n  position:absolute;right:14px;top:50%;transform:translateY(-50%);\n  border:none;cursor:pointer;background:transparent;padding:0;\n  font-size:16px;color:rgba(200,190,240,0.4);\n  transition:color .2s;line-height:1;\n}\n.pin-star:hover{color:rgba(200,190,240,0.7)}\n.pin-star.pinned{color:rgba(200,190,240,0.7)}\n.pin-star.pinned:hover{color:rgba(200,190,240,0.9)}\n.pin-star::after{\n  content:attr(data-tip);\n  position:absolute;right:calc(100% + 8px);top:50%;transform:translateY(-50%);\n  white-space:nowrap;font-size:10px;color:rgba(180,170,220,0.5);\n  font-family:-apple-system,sans-serif;pointer-events:none;\n  opacity:0;transition:opacity .2s;\n}\n.pin-star:hover::after{opacity:1}\n\n.fate-list{\n  display:flex;flex-direction:column;gap:6px;position:relative;\n  padding:0 18px 20px;\n  overflow:hidden;transition:max-height .35s ease,opacity .25s ease,padding .3s ease;\n}\n.fate-list.collapsed{max-height:0!important;opacity:0;padding-top:0;padding-bottom:0}\n\n.fate-card{\n  position:relative;border:none;border-radius:10px;\n  padding:14px 16px;cursor:pointer;width:100%;text-align:left;\n  background:rgba(255,255,255,0.04);\n  border:1px solid rgba(255,255,255,0.06);\n  transition:background .2s,border-color .2s;\n  display:flex;align-items:center;gap:14px;\n}\n.fate-card:hover{background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.12)}\n.fate-card:active{transform:scale(0.99)}\n.fate-card.sent{background:rgba(100,200,160,0.08);border-color:rgba(100,200,160,0.2)}\n.fate-card.fail{background:rgba(220,80,80,0.08);border-color:rgba(220,80,80,0.2)}\n\n/* SVG 图标 */\n.fate-icon{\n  flex-shrink:0;width:38px;height:38px;\n  display:flex;align-items:center;justify-content:center;\n  border-radius:10px;\n  background:rgba(200,190,240,0.06);\n  border:1px solid rgba(200,190,240,0.12);\n  transition:border-color .2s,background .2s;\n}\n.fate-icon svg{\n  width:26px;height:26px;display:block;\n  color:var(--icon-color,rgba(230,225,245,0.9));\n  filter:drop-shadow(0 1px 2px rgba(0,0,0,0.26));\n}\n.fate-icon path{fill:currentColor}\n.fate-card:hover .fate-icon{\n  border-color:rgba(220,210,250,0.26);\n  background:rgba(220,210,250,0.1);\n}\n\n.fate-body{flex:1;min-width:0}\n.fate-label{\n  font-size:10px;font-weight:500;letter-spacing:1.5px;\n  margin-bottom:4px;font-family:-apple-system,sans-serif;\n  text-transform:uppercase;color:rgba(255,255,255,0.28);\n}\n.fate-text{font-size:14px;color:rgba(240,238,250,0.82);line-height:1.6}\n.empty-r{text-align:center;color:rgba(180,170,220,0.3);font-size:13px;padding:28px;font-style:italic}\n</style>\n</head>\n<body>\n<div id=\"app\"></div>\n<div id=\"action-raw\">$1</div>\n<script>\n(function(){\nvar SK='fate_default_open',app=document.getElementById('app'),rawNode=document.getElementById('action-raw'),lastRaw='';\nvar defaultOpen=false;\ntry{defaultOpen=localStorage.getItem(SK)==='1'}catch(e){}\nvar collapsed=!defaultOpen;\n\n// SVG 图标与低饱和染色\nvar iconDefs=[\n  {label:'善良',color:'#c8d2a6',path:'M256.6 20.4c24.7 54-45.4 65.3-41 125.6l-43.4-39.6 14.8 67.2-65.8-23.7 39.5 56.3-69.79 3.3 55.69 35.4c-55.37 26.2-75.96-35-126.21 10.5 54.04-24.7 65.33 45.4 125.61 41l-39.6 43.4 67.2-14.8-23.7 65.8 56.3-39.5 3.3 69.7 35.4-55.6c26.2 55.6-35 75.6 10.5 126.6-24.7-54 45.4-66 41-126l43.4 40-14.8-67.6 65.8 23.7-39.5-56.3 69.8-3.3-55.7-35.4c55.4-26.2 76 35 126.2-10.5-54 24.7-65.3-45.4-125.5-41l39.5-43.4-67.2 14.8 23.7-65.8-56.3 39.5-3.3-69.8-35.4 55.7c-26.2-55.4 35-76-10.5-126.2zm-.6 134.1c56 0 101.5 45.5 101.5 101.5S312 357.5 256 357.5 154.5 312 154.5 256 200 154.5 256 154.5zm0 20.8c-44.5 0-80.7 36.2-80.7 80.7s36.2 80.7 80.