  "replaceString": "```text\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>opening shell</title>\n  <style>\n    html, body {\n      margin: 0;\n      padding: 0;\n      background: transparent;\n    }\n  </style>\n</head>\n<body>\n<script>\n(function () {\n  var url = 'http://127.0.0.1:5185/local-card/startup.html';\n\n  function injectEmbedFix(html) {\n    var style = [\n      '<style id=\"dnf-shell-embed-fix\">',\n      'html {',\n      '  height: auto !important;',\n      '  min-height: 0 !important;',\n      '}',\n      'body {',\n      '  height: auto !important;',\n      '  min-height: 0 !important;',\n      '}',\n      '</style>'\n    ].join('\\n');\n\n    var script = [\n      '<script>',\n      '(function () {',\n      '  var raf = 0;',\n      '  var ro = null;',\n      '  var mo = null;',\n      '',\n      '  function getHeight() {',\n      '    var app = document.getElementById(\"app\");',\n      '    if (!app) return 600;',\n      '',\n      '    var body = document.body;',\n      '    var bodyStyle = body ? getComputedStyle(body) : null;',\n      '    var pt = bodyStyle ? (parseFloat(bodyStyle.paddingTop) || 0) : 0;',\n      '    var pb = bodyStyle ? (parseFloat(bodyStyle.paddingBottom) || 0) : 0;',\n      '',\n      '    var rect = app.getBoundingClientRect();',\n      '    var appHeight = Math.max(',\n      '      app.scrollHeight || 0,',\n      '      app.offsetHeight || 0,',\n      '      rect.height || 0',\n      '    );',\n      '',\n      '    return Math.max(1, Math.ceil(appHeight + pt + pb));',\n      '  }',\n      '',\n      '  function applyHeight() {',\n      '    raf = 0;',\n      '    var h = getHeight();',\n      '    try {',\n      '      if (window.frameElement) {',\n      '        window.frameElement.style.minHeight = \"0px\";',\n      '        window.frameElement.style.height = h + \"px\";',\n      '      }',\n      '    } catch (e) {}',\n      '  }',\n      '',\n      '  function queue() {',\n      '    if (raf) return;',\n      '    raf = requestAnimationFrame(applyHeight);',\n      '  }',\n      '',\n      '  function install() {',\n      '    var app = document.getElementById(\"app\");',\n      '    if (!app) {',\n      '      setTimeout(queue, 100);',\n      '      setTimeout(queue, 300);',\n      '      setTimeout(queue, 800);',\n      '      return;',\n      '    }',\n      '',\n      '    if (window.ResizeObserver) {',\n      '      ro = new ResizeObserver(queue);',\n      '      ro.observe(app);',\n      '    }',\n      '',\n      '    if (window.MutationObserver) {',\n      '      mo = new MutationObserver(queue);',\n      '      mo.observe(app, {',\n      '        childList: true,',\n      '        subtree: true,',\n      '        attributes: true',\n      '      });',\n      '    }',\n      '',\n      '    window.addEventListener(\"load\", queue);',\n      '    window.addEventListener(\"resize\", queue);',\n      '',\n      '    if (document.fonts && document.fonts.ready) {',\n      '      document.fonts.ready.then(queue).catch(function () {});',\n      '    }',\n      '',\n      '    Array.prototype.forEach.call(document.images || [], function (img) {',\n      '      if (!img.complete) {',\n      '        img.addEventListener(\"load\", queue, { once: true });',\n      '        img.addEventListener(\"error\", queue, { once: true });',\n      '      }',\n      '    });',\n      '',\n      '    setTimeout(queue, 0);',\n      '    setTimeout(queue, 50);',\n      '    setTimeout(queue, 150);',\n      '    setTimeout(queue, 400);',\n      '    setTimeout(queue, 1000);',\n      '  }',\n      '',\n      '  if (document.readyState === \"loading\") {',\n      '    document.addEventListener(\"DOMContentLoaded\", install, { once: true });',\n      '  } else {',\n      '    install();',\n      '  }',\n      '})();',\n      '<\\/script>'\n    ].join('\\n');\n\n    if (html.indexOf('</head>') !== -1) {\n      html = html.replace('</head>', style + '\\n</head>');\n    } else {\n      html = style + html;\n    }\n\n    if (html.indexOf('</body>') !== -1) {\n      html = html.replace('</body>', script + '\\n</body>');\n    } else {\n      html += script;\n    }\n\n    return html;\n  }\n\n  fetch(url, { cache: 'no-store' })\n    .then(function (res) {\n      if (!res.ok) throw new Error(String(res.status));\n      return res.text();\n    })\n    .then(function (html) {\n      document.open();\n      document.write(injectEmbedFix(html));\n      document.close();\n    })\n    .catch(function (err) {\n      document.body.innerHTML = '<pre style=\"padding:16px;\">加载失败：' + err.message + '</pre>';\n    });\n})();\n</script>\n</body>\n</html>\n```",
